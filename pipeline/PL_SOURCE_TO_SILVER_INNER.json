{
	"name": "PL_SOURCE_TO_SILVER_INNER",
	"properties": {
		"activities": [
			{
				"name": "Read_table_details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set Start Date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Set _Start_Time",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Landing_to_bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Check Source Sytem Switch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Project1/AzureDataBricks_proejct1/Landing_To_Bronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('Set _Start_Time')",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('Read_table_details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read_table_details').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"source_file_format": {
							"value": "@coalesce(activity('Read_table_details').output.firstRow.source_file_format, '')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze_to_silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing_to_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Project1/AzureDataBricks_proejct1/Bronze_to_Silver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('Set _Start_Time')",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read_table_details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(\r\nactivity('Read_table_details').output.firstRow.merge_keys,'')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read_table_details').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Insert_SUCCESS",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze_to_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_AzureSqlDatabaseproj1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE [ctrl].[audit_log]\nSET\n    status = 'SUCCESS',\n    records_written = @{activity('bronze_to_silver').output.runOutput},\n    end_time = SYSUTCDATETIME()\nWHERE\n    adf_run_id = '@{pipeline().parameters.adf_run_id_inner}'\n    AND table_id = '@{pipeline().parameters.table_id}';",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read_table_details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Start Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read_table_details').output.firstRow.load_type,\r\n'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "read_watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT *\nFROM ctrl.watermark\nWHERE table_id = @{pipeline().parameters.table_id};",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Store_water_value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "read_watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('read_watermark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "checking Load Type and Update Watermark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "bronze_to_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read_table_details').output.firstRow.load_type,\n'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update watermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_AzureSqlDatabaseproj1",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.watermark\nset watermark_value =  sysutcdatetime()\nWHERE  table_id = @{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Check Source Sytem Switch",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "If Condition1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Read_table_details').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "Copy _source_to_landing",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "select * from public.@{activity('Read_table_details').output.firstRow.source_table_name}\n@{\n   if(equals(activity('Read_table_details').output.firstRow.load_type, 'FULL')\n     ,''\n     ,concat(\n        'where ',activity('Read_table_details').output.firstRow.watermark_column,  '>', '''', variables('watermark_value'),''''\n     )\n    )\n}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_PostgreSqlTable1",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_ParquetPROJ1",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(\nactivity('Read_table_details').output.firstRow.source_system,\n'/',\nactivity('Read_table_details').output.firstRow.source_table_name,\n'/',\nvariables('Set _Start_Time') \n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv",
							"activities": [
								{
									"name": "ingest csv from Source to landing",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"modifiedDatetimeStart": {
													"value": "@variables('watermark_value')",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "DS_CSV_SOURCE",
											"type": "DatasetReference",
											"parameters": {
												"folder": {
													"value": "@activity('Read_table_details').output.firstRow.source_path",
													"type": "Expression"
												},
												"container": "source"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_CSV_SOURCE",
											"type": "DatasetReference",
											"parameters": {
												"folder": {
													"value": "@concat(\nactivity('Read_table_details').output.firstRow.source_system,\n'/',\nactivity('Read_table_details').output.firstRow.source_table_name,\n'/',\nvariables('Set _Start_Time') \n)",
													"type": "Expression"
												},
												"container": "landing"
											}
										}
									]
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id_inner": {
				"type": "string",
				"defaultValue": "'a'"
			}
		},
		"variables": {
			"Set _Start_Time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"folder": {
			"name": "caresync"
		},
		"annotations": []
	}
}