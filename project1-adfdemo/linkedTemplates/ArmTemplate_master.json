{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "project1-adfdemo"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://project1storagejyoti.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1117-063502-o9kvu93v"
		},
		"LS_PostgreSqlPROJ1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-winter-mountain-b3m6h5tb-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSqlPROJ1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSqlPROJ1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"ls_AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://key-vault-proj1.vault.azure.net/"
		},
		"ls_AzureSqlDatabaseproj1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project1serverjyoti.database.windows.net"
		},
		"ls_AzureSqlDatabaseproj1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "project1dbjyoti"
		},
		"ls_AzureSqlDatabaseproj1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jyotiadminproj1"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "project1-adfdemo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"LS_PostgreSqlPROJ1_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSqlPROJ1_properties_typeProperties_server')]"
					},
					"LS_PostgreSqlPROJ1_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSqlPROJ1_properties_typeProperties_database')]"
					},
					"LS_PostgreSqlPROJ1_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSqlPROJ1_properties_typeProperties_username')]"
					},
					"ls_AzureSqlDatabaseproj1_properties_typeProperties_server": {
						"value": "[parameters('ls_AzureSqlDatabaseproj1_properties_typeProperties_server')]"
					},
					"ls_AzureSqlDatabaseproj1_properties_typeProperties_database": {
						"value": "[parameters('ls_AzureSqlDatabaseproj1_properties_typeProperties_database')]"
					},
					"ls_AzureSqlDatabaseproj1_properties_typeProperties_userName": {
						"value": "[parameters('ls_AzureSqlDatabaseproj1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}